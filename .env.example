# ================= Backend (FastAPI) =================
# PostgreSQL in production / docker, SQLite for quick local dev:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/nexshop

# IMPORTANT: change this in production (long random string)
JWT_SECRET=change-me-to-a-long-random-string-32+

# Public URL of the web app (used for Stripe redirect + links)
FRONTEND_URL=http://localhost:8081

# Comma separated list, or * for all (development)
CORS_ORIGINS=*

ENV=development
# Create tables automatically on boot (dev convenience). In production use Alembic:
AUTO_CREATE_TABLES=true
# Seed demo data when the database is empty
AUTO_SEED=true
PORT=8000

# ================= Payments =================
# Leave STRIPE_SECRET_KEY empty to run in DEMO payments mode
# (orders are marked paid automatically — great for demos & selling the template).
# NOTE: demo mode is automatically IGNORED when ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ================= Email (SMTP) =================
# When EMAIL_ENABLED=false, emails are printed to the console (dev mode).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NexShop <no-reply@nexshop.local>

# ================= Uploads & security =================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
RATE_LIMIT_ENABLED=true

# ================= Web app (build-time) =================
# Leave empty to auto-detect in development.
# Set to your deployed API URL when exporting for production:
#   EXPO_PUBLIC_API_URL=https://your-api.onrender.com/api
EXPO_PUBLIC_API_URL=

# ================= White-label quick config =================
# Values here are build-time defaults. Runtime branding always comes from
# GET /api/meta/brand (editable live from the Admin → Settings screen).
EXPO_PUBLIC_STORE_NAME=NexShop
EXPO_PUBLIC_PRIMARY_COLOR=#6C4DF6
EXPO_PUBLIC_THEME_PRESET=aurora
