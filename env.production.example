# ============================================================================
# NexShop — Production environment template
# Copy to .env next to docker-compose.yml and fill in every value.
# ============================================================================

# ---- Core (REQUIRED) -------------------------------------------------------
# production disables demo-payments automatically (orders can't be
# auto-confirmed without real payment)
ENV=production

# Generate with:  openssl rand -hex 32
JWT_SECRET=PASTE_64_CHAR_RANDOM_STRING_HERE

# Your real PostgreSQL (docker-compose db, Neon, Supabase, Render...)
POSTGRES_USER=shop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nexshop

# Public URL of the storefront (used in Stripe redirects + emails)
FRONTEND_URL=https://your-store.com

# LOCK THIS DOWN — comma separated origins, no wildcards in production
CORS_ORIGINS=https://your-store.com,https://www.your-store.com

# ---- Payments (Stripe) -------------------------------------------------------
# Live or test secret key. While empty the store runs COD/wallets only
# (demo mode is IGNORED when ENV=production).
STRIPE_SECRET_KEY=
# From: Stripe Dashboard → Developers → Webhooks → endpoint →/api/payments/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ---- Email (order confirmations + password reset) ---------------------------
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=orders@your-store.com
SMTP_PASSWORD=SMTP_PASSWORD_HERE
SMTP_FROM=Your Store <orders@your-store.com>

# ---- Seed --------------------------------------------------------------------
# Keep true only for the first boot of a demo/sales copy; set false for a
# real customer store so no demo products or demo accounts are created.
AUTO_SEED=false
