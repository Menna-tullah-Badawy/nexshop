{
  "expo": {
    "name": "NexShop",
    "slug": "nexshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexshop",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexshop.app"
    },
    "android": {
      "package": "com.nexshop.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
